<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flandreyu.mapper.UserMapper">

    <sql id="columns">
        id, username, password, email, nickname, avatar, created_at
    </sql>

    <insert id="insert" parameterType="User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `user` (username, password, email, nickname, avatar)
        VALUES (#{username}, #{password}, #{email}, #{nickname}, #{avatar})
    </insert>

    <select id="findById" parameterType="long" resultType="User"> SELECT <include refid="columns" />
        FROM `user` WHERE id = #{id} </select>

    <select id="findByUsername" parameterType="string" resultType="User"> SELECT <include
            refid="columns" /> FROM `user` WHERE username = #{username} </select>

    <select id="findByEmail" parameterType="string" resultType="User"> SELECT <include
            refid="columns" /> FROM `user` WHERE email = #{email} </select>

    <!-- 动态更新：昵称 / 头像 / 邮箱 / 密码按需更新（用户名不允许改） -->
    <update id="update" parameterType="User"> UPDATE `user` <set>
            <if test="password != null">password = #{password},</if>
            <if test="email != null">email = #{email},</if>
            <if test="nickname != null">nickname = #{nickname},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
        </set> WHERE id = #{id} </update>

    <delete id="deleteById" parameterType="long">
        DELETE FROM `user` WHERE id = #{id}
    </delete>

</mapper>