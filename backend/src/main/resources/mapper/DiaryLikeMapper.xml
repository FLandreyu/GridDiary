<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flandreyu.mapper.DiaryLikeMapper">

    <sql id="columns">
        id, diary_id, user_id, created_at
    </sql>

    <insert id="insert" parameterType="DiaryLike" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `diary_like` (diary_id, user_id)
        VALUES (#{diaryId}, #{userId})
    </insert>

    <delete id="delete">
        DELETE FROM `diary_like`
        WHERE diary_id = #{diaryId} AND user_id = #{userId}
    </delete>

    <select id="find" resultType="DiaryLike"> SELECT <include refid="columns" /> FROM `diary_like`
        WHERE diary_id = #{diaryId} AND user_id = #{userId} </select>

    <select id="countByDiaryId" parameterType="long" resultType="long">
        SELECT COUNT(*) FROM `diary_like` WHERE diary_id = #{diaryId}
    </select>

</mapper>